# Vercel admin build only; publishable keys are public and protected by RLS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Vercel server environment only. Never prefix secret values with VITE_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
CRON_SECRET=replace_with_a_random_secret_of_at_least_16_characters
# Optional JSON list; default ACI Prensa feeds are used when omitted.
# NEWS_FEEDS=[{"name":"ACI Prensa","url":"https://www.aciprensa.com/rss/news","region":"universal"}]